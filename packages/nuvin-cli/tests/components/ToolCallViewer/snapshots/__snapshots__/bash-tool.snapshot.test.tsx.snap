exports[`bash_tool - Snapshot Tests > renders bash command with special characters in output 1`] = `
"⚙ Run npm test
  │  ✓ Tests passed
  │  ✗ 2 warnings
  │  🚀 Build complete
  │  Path: /usr/local/bin → ~/.local/bin
  └─ Executed (exit 0)"
`;

exports[`bash_tool - Snapshot Tests > renders successful bash command execution 1`] = `
"⚙ Run ls -la at /Users/user/project
  │  total 64
  │  drwxr-xr-x  12 user  staff   384 Jan 31 10:00 src
  │  drwxr-xr-x   5 user  staff   160 Jan 31 10:00 tests
  └─ Executed (exit 0)"
`;
