// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`bash_tool - Snapshot Tests > renders bash command with empty output 1`] = `
"⚙ Run touch newfile.txt
  └─ Executed (exit 0)"
`;

