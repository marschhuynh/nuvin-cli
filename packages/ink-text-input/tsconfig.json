{
  "extends": "@sindresorhus/tsconfig",
  "compilerOptions": {
    "outDir": "build",
    "rootDir": "src",
    "types": ["react"],
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "sourceMap": true,
    "declarationMap": true,
    "jsx": "react-jsx",
    "isolatedModules": true
  },
  "include": ["src"],
  "ts-node": {
    "transpileOnly": true,
    "files": true,
    "experimentalResolver": true,
    "experimentalSpecifierResolution": "node"
  }
}
