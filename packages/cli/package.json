{
  "name": "@nuvin/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "nuvin-cli": "./dist/index.js"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "clean": "rm -rf dist",
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "run:prod": "node dist/index.js",
    "prepack": "rm -rf dist && pnpm run build"
  },
  "dependencies": {
    "@nuvin/agent-core": "workspace:*",
    "@nuvin/config": "workspace:*",
    "@nuvin/ink": "workspace:*",
    "@nuvin/ink-input": "workspace:*",
    "@nuvin/ink-text-input": "workspace:*",
    "@nuvin/ink-virtualized-list": "workspace:*",
    "ansi-escapes": "^7.2.0",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "cli-table3": "^0.6.5",
    "ink-spinner": "^5.0.0",
    "marked": "^15.0.12",
    "node-emoji": "^2.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "string-width": "^8.1.0",
    "supports-hyperlinks": "^3.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "javascript-obfuscator": "^4.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
